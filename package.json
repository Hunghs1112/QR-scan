{
  "name": "ScanCode",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "test": "jest",
    "lint": "eslint .",
    "postinstall": "patch-package",
    "ios": "react-native run-ios",
    "start": "react-native start",
    "asset": "npx react-native-asset",
    "android": "react-native run-android",
    "pod": "cd ios && pod install && cd ..",
    "clean": "yarn cache clean && cd android && ./gradlew clean && cd ..",
    "aab": "cd android && ./gradlew clean && ./gradlew bundleRelease && cd ..",
    "apk": "cd android && ./gradlew clean && ./gradlew assembleRelease && cd ..",
    "androidapk": "cd android && ./gradlew assembleRelease && cd .."
  },
