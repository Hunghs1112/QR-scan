require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
else
  use_frameworks! :linkage => :static
end

target 'ScanCode' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  # Firebase dependencies (chuẩn mới, không dùng Firebase/Core)
  pod 'Firebase'
  pod 'Firebase/Messaging'

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
    )

    # Fix cho iOS 17 build warnings
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
        config.build_settings['ONLY_ACTIVE_ARCH'] = 'YES'
      end
    end

    # Fix loi fmt consteval khi Archive voi Xcode 26+
    # Apple clang 21 (Xcode 26.4+) ap dung chat che hon ve constant expression,
    # lam FMT_STRING("{}{}") trong format-inl.h khong the fold thanh compile-time
    # constant. base.h khong check -D FMT_USE_CONSTEVAL nen chi set flag khong du.
    # Fix: patch base.h de __cpp_consteval branch tra ve 0 thay vi 1.
    fmt_base_path = File.join(installer.sandbox.root, 'fmt', 'include', 'fmt', 'base.h')
    if File.exist?(fmt_base_path)
      original = File.read(fmt_base_path)
      sentinel = '// Xcode 26 workaround: disable consteval'
      unless original.include?(sentinel)
        patched = original.gsub(
          /^(#elif defined\(__cpp_consteval\)\n#  define FMT_USE_CONSTEVAL) 1/,
          "// Xcode 26 workaround: disable consteval\n\\1 0"
        )
        if patched != original
          File.chmod(0644, fmt_base_path)
          File.write(fmt_base_path, patched)
          Pod::UI.puts "Patched fmt/base.h: disabled consteval for Xcode 26+ archive".yellow
        else
          Pod::UI.puts "Could not patch fmt/base.h: __cpp_consteval branch not found".red
        end
      end
    end
  end
end
